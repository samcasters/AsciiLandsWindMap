<Window x:Class="AsciiLandsWindMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AsciiLandsWindMap"
        Title="AsciiLands Wind Map"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Trebuchet MS" FontSize="14"
        PreviewKeyDown="WindowKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,6">
      <WrapPanel VerticalAlignment="Center">
        <Grid Width="230" Margin="4,2">
          <TextBox x:Name="SearchBox" ToolTip="Search regions (Ctrl+F)" TextChanged="SearchChanged" KeyDown="SearchKeyDown"/>
          <TextBlock x:Name="SearchHint" Text="Search regions" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
          <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <ListBox x:Name="SearchList" Width="280" MaxHeight="260" DisplayMemberPath="Name"
                     KeyDown="SearchListKeyDown" MouseLeftButtonUp="SearchListClick"
                     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource LineBrush}"/>
          </Popup>
        </Grid>
        <Button x:Name="DayButton" Content="Day" Margin="10,2,2,2" Click="DayClick" ToolTip="Show the daytime breeze, onto land"/>
        <Button x:Name="NightButton" Content="Night" Margin="2" Click="NightClick" ToolTip="Show the nighttime breeze, out to sea"/>
        <Button x:Name="LiveButton" Content="Live" Margin="2,2,8,2" Click="LiveClick" ToolTip="Follow the clock you matched from the game"/>
        <StackPanel Margin="6,0" VerticalAlignment="Center">
          <TextBlock x:Name="ClockText" MinWidth="260"/>
          <Button x:Name="GpsButton" Content="GPS" Margin="0,4,0,0" Padding="12,2" HorizontalAlignment="Left" Click="GpsClick" ToolTip="Pick Boat or Walk, then click the destination hex"/>
        </StackPanel>
        <Button Content="Match game clock" Margin="4,2" Click="MatchClockClick"/>
        <ComboBox x:Name="RealmBox" Width="150" Margin="4,2" VerticalAlignment="Center" SelectionChanged="RealmChanged"/>
        <Button Content="Show all" Margin="4,2" Click="FitClick" ToolTip="Fit every region on screen"/>
        <Button x:Name="SyncButton" Content="Sync map" Margin="4,2" Click="SyncClick"/>
        <Button Content="Export" Margin="4,2" Click="ExportClick"/>
        <Button Content="Import" Margin="4,2" Click="ImportClick"/>
        <Button Content="Notice" Margin="4,2" Click="NoticeClick" ToolTip="Read the notice about what this app reads"/>
        <Button Content="Credits" Margin="4,2" Click="CreditsClick" ToolTip="Who made this map"/>
      </WrapPanel>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,4,8,6">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ToggleButton x:Name="GameSyncButton" Content="Sync" Margin="0,0,8,0" Padding="12,4" Checked="GameSyncToggled" Unchecked="GameSyncToggled" ToolTip="Read the open Asciilands game every 5 seconds and fill sea wind"/>
        <Button x:Name="UpdateMapButton" Content="Update map" Margin="0,0,8,0" Padding="12,4" Click="UpdateMapClick" ToolTip="Read visited tiles from the map you have open in the game"/>
        <TextBlock x:Name="SyncStatus" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="InfoColumn" Width="360"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <local:HexMapControl x:Name="Map" PreviewMouseLeftButtonDown="MapPreviewDown"/>
        <TextBlock x:Name="EmptyText" Text="Downloading the Asciilands map…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" IsHitTestVisible="False"/>
      </Grid>
      <Border x:Name="InfoOpen" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Top" Content="Hide" Margin="14,10,14,0" Padding="10,4" HorizontalAlignment="Left" Click="ToggleInfoClick" ToolTip="Hide the wind map panel"/>
          <local:TilePanel x:Name="Tile"/>
        </DockPanel>
      </Border>
      <Button x:Name="InfoClosed" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="8,14" Click="ToggleInfoClick" ToolTip="Show the wind map panel">
        <TextBlock Text="Wind map">
          <TextBlock.LayoutTransform>
            <RotateTransform Angle="-90"/>
          </TextBlock.LayoutTransform>
        </TextBlock>
      </Button>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HoverText" Text="Drag to pan. Scroll to zoom. Click a hex." TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="640"/>
      </Grid>
    </Border>
  </Grid>
</Window>
