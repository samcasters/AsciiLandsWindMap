<Window x:Class="AsciiLandsWindMap.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import wind map"
        Width="680" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
  <DockPanel Margin="16">
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Keep all mine" Click="KeepAllClick"/>
      <Button Content="Use all imported" Click="UseAllClick"/>
      <Button Content="Cancel" Click="CancelClick" IsCancel="True"/>
      <Button Content="Apply" Click="ApplyClick" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="White"/>
    </StackPanel>
    <ListBox x:Name="ConflictList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,6">
            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
              <Run Text="Yours: "/>
              <Run Text="{Binding Local}"/>
            </TextBlock>
            <TextBlock Margin="0,2,0,4" TextWrapping="Wrap">
              <Run Text="Imported: "/>
              <Run Text="{Binding Theirs}"/>
            </TextBlock>
            <ComboBox Width="180" HorizontalAlignment="Left" SelectedIndex="{Binding ChoiceIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              <ComboBoxItem Content="Keep mine"/>
              <ComboBoxItem Content="Use imported"/>
            </ComboBox>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
