<Window x:Class="AsciiLandsWindMap.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credits"
        Width="420" Height="280"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Trebuchet MS" FontSize="15">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Credits" FontSize="22" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,18,0,16">
      <TextBlock Text="solarflare" FontSize="18"/>
      <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}" Text="Discord: solarflare1337"/>
      <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" Text="In game: solarflare"/>
    </StackPanel>
    <Button Grid.Row="2" Content="Close" MinWidth="120" Padding="12,8" HorizontalAlignment="Right"
            Click="CloseClick" IsCancel="True" IsDefault="True"/>
  </Grid>
</Window>
