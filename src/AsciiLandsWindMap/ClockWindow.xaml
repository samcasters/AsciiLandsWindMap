<Window x:Class="AsciiLandsWindMap.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match the game clock"
        Width="460" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
  <StackPanel Margin="18">
    <TextBlock TextWrapping="Wrap" Text="Look at the clock in the corner of Asciilands and type that time. The wiki does not publish a server clock, so this is how Live stays in step."/>
    <TextBlock Margin="0,14,0,4" Text="Game time"/>
    <TextBox x:Name="TimeBox"/>
    <TextBlock Margin="0,14,0,4" Text="Real minutes in one game day"/>
    <TextBox x:Name="LengthBox"/>
    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Leave this blank to hold the time until you match it again. If you know the length, Live will keep ticking."/>
    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="90" Click="CancelClick" IsCancel="True"/>
      <Button Content="Use this time" Margin="8,0,0,0" Padding="12,6" Click="OkClick" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="White"/>
    </StackPanel>
  </StackPanel>
</Window>
