<UserControl x:Class="AsciiLandsWindMap.TilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PanelBrush}">
  <Grid>
    <ScrollViewer x:Name="HelpPanel" VerticalScrollBarVisibility="Auto" Padding="18,8,18,18">
      <StackPanel>
        <TextBlock Text="Wind map" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Click a hex to read that tile."/>
        <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Wind arrows"/>
        <TextBlock Margin="0,6,0,0" Text="~ light     ≈ fresh     ≋ strong"/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="The arrow points where the wind is going. A bigger arrow is a stronger wind."/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Gold dot: favorite. Amber diamond: storm or gale."/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="Coral outline: the hex you are in."/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="A chart on a hex is the game's own tile. The pale line is the GPS route."/>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Text="Day and Night switch the breeze: onto land from 10:00 to 19:00, out to sea from 23:00 to 09:00. The hours between those are Turning. Arrows change once each in-game hour."/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="Sync starts on and reads the open game every 5 seconds. Live follows that clock. Ocean arrows come from the game's own wind formula."/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="Edit changes the description, note, mark, and tags on a tile. Export shares those notes. It does not share the wind."/>
        <TextBlock x:Name="MapTimeText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
    </ScrollViewer>

    <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
      <Grid DockPanel.Dock="Top" Margin="16,12,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <TextBlock x:Name="NameText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="MetaText" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
          <TextBlock x:Name="EditorTimeText" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="1" Content="X" VerticalAlignment="Top" Padding="10,4" Click="CloseClick" ToolTip="Close"/>
      </Grid>

      <StackPanel x:Name="ReadBar" DockPanel.Dock="Bottom" Margin="16,8,16,14">
        <Button Content="Edit" Click="EditClick" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource InkBrush}"/>
      </StackPanel>
      <StackPanel x:Name="EditBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="16,8,16,14">
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <Button Content="Save" Click="SaveMetaClick" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource InkBrush}"/>
        <Button Content="Cancel" Click="CancelEditClick" Margin="2,6,2,0"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="ReadBody" Margin="16,0,16,8">
            <TextBlock Text="Wind" FontWeight="SemiBold"/>
            <TextBlock x:Name="WindText" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Description" Margin="0,14,0,4" FontWeight="SemiBold"/>
            <TextBlock x:Name="CaptionRead" TextWrapping="Wrap"/>
            <TextBlock Text="Note" Margin="0,14,0,4" FontWeight="SemiBold"/>
            <TextBlock x:Name="NoteRead" TextWrapping="Wrap"/>
            <TextBlock Text="Map mark" Margin="0,14,0,4" FontWeight="SemiBold"/>
            <TextBlock x:Name="MarkRead" TextWrapping="Wrap"/>
            <TextBlock Text="Tags" Margin="0,14,0,4" FontWeight="SemiBold"/>
            <TextBlock x:Name="TagsRead" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel x:Name="EditBody" Visibility="Collapsed" Margin="16,0,16,8">
            <TextBlock Text="Description" Margin="0,0,0,4"/>
            <TextBox x:Name="CaptionBox" MaxLength="80"/>
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Shown under the tile name."/>
            <TextBlock Text="Note" Margin="0,12,0,4"/>
            <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Map mark" Margin="0,12,0,4"/>
            <WrapPanel x:Name="IconWrap"/>
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Sits at the bottom of the hex. Click the chosen mark again to clear it."/>
            <TextBlock Text="Tags" Margin="0,12,0,4"/>
            <WrapPanel x:Name="BuiltInWrap"/>
            <DockPanel Margin="0,4,0,0" LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Add" Click="AddTagClick" Margin="6,0,0,0"/>
              <TextBox x:Name="CustomTagBox" KeyDown="CustomTagKeyDown"/>
            </DockPanel>
            <WrapPanel x:Name="CustomWrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
