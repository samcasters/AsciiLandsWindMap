<Window x:Class="AsciiLandsWindMap.GpsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPS"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Trebuchet MS" FontSize="14">
  <StackPanel Margin="18,16">
    <TextBlock Text="How are you traveling?" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal">
      <Button Content="Boat" Margin="0,0,8,0" Padding="14,6" IsDefault="True" Click="BoatClick"/>
      <Button Content="Walk" Margin="0,0,8,0" Padding="14,6" Click="WalkClick"/>
      <Button x:Name="ClearButton" Content="Clear route" Margin="0,0,8,0" Padding="14,6" Click="ClearClick"/>
      <Button Content="Cancel" Padding="14,6" IsCancel="True" Click="CancelClick"/>
    </StackPanel>
  </StackPanel>
</Window>
